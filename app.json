{
  "expo": {
    "name": "Soli",
    "slug": "soli",
    "version": "1.2.0",
    "description": "A polished Klondike Solitaire experience with responsive animations and a solvable shuffle catalog.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soli",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app.icon",
      "supportsTablet": true,
      "bundleIdentifier": "ch.karimattia.soli",
      "buildNumber": "17",
      "deploymentTarget": "16.4",
      "associatedDomains": ["applinks:karimattia.ch"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#416F57"
      },
      "package": "ch.karimattia.soli",
      "versionCode": 17,
      "permissions": [],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "karimattia.ch",
              "pathPrefix": "/soli/deal"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "CardTextAndroid",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/CardTextAndroid.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/CardTextAndroid-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/CardTextAndroid-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/CardTextAndroid.ttf",
              "./assets/fonts/CardTextAndroid-SemiBold.ttf",
              "./assets/fonts/CardTextAndroid-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#416F57",
          "image": "./assets/images/icon.png",
          "imageWidth": 368,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "./plugins/withBuildSpeedGradleProperties",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "de", "fr", "es", "pt-BR", "it", "nl", "ja", "ru", "pl", "tr", "zh-Hans", "ko", "ar", "he"],
            "android": ["en", "de", "fr", "es", "pt-BR", "it", "nl", "ja", "ru", "pl", "tr", "zh-Hans", "ko", "ar", "he"]
          },
          "supportsRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9de7c7ee-2f1d-418d-ad51-eee7ede5d609"
      }
    }
  }
}
