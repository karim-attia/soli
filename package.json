{
  "name": "soli",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "format": "oxfmt \"{app,components,modules,src,scripts,test}/**/*.{js,jsx,ts,tsx,json}\" package.json",
    "format:check": "oxfmt --check \"{app,components,modules,src,scripts,test}/**/*.{js,jsx,ts,tsx,json}\" package.json",
    "lint": "oxlint --tsconfig tsconfig.json app components modules src scripts test",
    "lint:fix": "oxlint --fix --tsconfig tsconfig.json app components modules src scripts test",
    "lint:strict": "oxlint --deny-warnings --tsconfig tsconfig.json app components modules src scripts test",
    "typecheck": "tsc -p tsconfig.json",
    "ad": "AGENT_DEVICE_IOS_RUNNER_IDLE_STOP_MS=0 agent-device",
    "start": "expo start -c",
    "release": "./run-android-release.sh",
    "ios": "node scripts/build-install-ios.js",
    "deeplink": "node scripts/deeplink.js",
    "celebration": "node scripts/deeplink.js celebration",
    "scrubtest": "node scripts/deeplink.js scrubtest",
    "nearwin": "node scripts/deeplink.js nearwin",
    "vegas": "node scripts/deeplink.js vegas",
    "seedhistory": "node scripts/deeplink.js seedhistory",
    "build:ios": "node scripts/ensure-rust-solver.js && npx eas-cli build --platform ios --profile production --non-interactive",
    "test": "jest --watchAll",
    "generate:solvable-deals": "node scripts/generate-solvable-deals-v2.js",
    "build:android": "./build-android.sh",
    "submit:android": "node scripts/submit-android.js",
    "submit:ios": "npx eas-cli submit --platform ios --latest --non-interactive",
    "prebuild": "yarn prebuild:android",
    "prebuild:android": "npx expo prebuild --platform android --clean",
    "prebuild:ios": "npx expo prebuild --platform ios --clean"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.20",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "lucide-react-native": "1.50.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/metro-runtime": "~58.0.14",
    "@react-native/jest-preset": "^0.88.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "agent-device": "0.21.28",
    "babel-preset-expo": "~58.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "oxfmt": "0.54.0",
    "oxlint": "1.88.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^7.0.2"
  },
  "dependenciesMeta": {
    "@shopify/react-native-skia": {
      "built": true
    }
  },
  "jest": {
    "moduleNameMapper": {
      "^expo-sqlite$": "<rootDir>/test/mocks/expo-sqlite",
      "^expo-sqlite/kv-store$": "<rootDir>/test/mocks/expo-sqlite-kv-store"
    },
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFiles": [
      "<rootDir>/test/setup/mock-expo-crypto.ts"
    ]
  },
  "packageManager": "yarn@4.17.1",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
